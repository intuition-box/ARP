{
  "name": "arp",
  "version": "0.0.0",
  "private": true,
  "description": "ARP — Agent Reputation Protocol: the web app, the MCP server, the node, the protocol packages and the contracts.",
  "engines": {
    "node": ">=20",
    "bun": ">=1.2"
  },
  "workspaces": [
    "apps/web",
    "apps/mcp",
    "apps/node",
    "apps/hook",
    "apps/cli",
    "apps/api",
    "apps/probe",
    "apps/sponsor",
    "contracts",
    "packages/graphql",
    "packages/protocol"
  ],
  "scripts": {
    "verify:pin": "bun scripts/verify/verify-pin-key.ts",
    "dev": "bun --filter @arp/app dev",
    "build": "bun --filter '*' build",
    "test": "bun run --filter '*' --sequential test && bun run test:scripts",
    "test:scripts": "bun test ./scripts/test",
    "lint": "bun run --filter '*' --sequential lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "check:scripts": "bun run --cwd packages/protocol build && bunx tsc -p tsconfig.scripts.json --noEmit",
    "check": "bun run check:scripts && bun run --cwd apps/web check:tokens && bun run --cwd apps/web check:contrast"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@x402/fetch": "2.28.0",
    "prettier": "^3.3.3",
    "viem": "2.52.0"
  },
  "overrides": {
    "viem": "2.52.0"
  }
}
