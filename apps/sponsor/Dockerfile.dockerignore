# Read by BuildKit for apps/sponsor/Dockerfile, with the repository root as the context.
# An allowlist: nothing enters the image unless it is named here, so no key, `.env`, `.dev.vars`,
# `.wrangler` or local state can, whatever sits untracked in the checkout. The key is mounted at run
# time, the ledger is a volume.
*

# The workspace's manifests: `bun install --frozen-lockfile` resolves every workspace from the lockfile.
!package.json
!bun.lock
!apps/*/package.json
!contracts/package.json

# What the service runs and builds.
!apps/sponsor
!packages/protocol
!packages/graphql

# The two data files it reads at start.
!data/deployments/13579.json
!data/catalogue/domains.proposal.json

# Dropped again inside what was allowed.
**/node_modules
**/dist
**/test
**/*.test.ts
**/.env
**/.env.*
**/.dev.vars*
**/.wrangler
**/*.key
**/*.jsonl
**/.arp
