# ARP's hosted content server (task 131, ADR 0196). Testnet 13579 only.
#   docker build -f apps/mcp/Dockerfile.content -t arp-content .
# The build context is the repository root. apps/mcp/Dockerfile.content.dockerignore is an allowlist.
#
# It serves GET /content/:atomId and GET / and nothing else: no MCP, no tool, no search. It holds one
# key, mounted as a file (ARP_RECEIPT_KEY_FILE), that signs content receipts and cannot move value
# (ADR 0080). The key is never in the image or the environment. The server refuses to start without
# ARP_TARGET=testnet, ARP_PUBLIC_HOST and a readable key file (apps/mcp/src/content-server.ts).

FROM oven/bun:1.3.14
WORKDIR /repo

COPY . .
# No build of packages/protocol: under bun, its `package.json` exports resolve to `src/` (task 124).
RUN bun install --frozen-lockfile --ignore-scripts \
    && chmod 755 apps/mcp/content-entrypoint.sh

ENV ARP_TARGET=testnet \
    ARP_HOST=0.0.0.0 \
    PORT=3003 \
    ARP_HOME=/tmp/arp

USER bun
EXPOSE 3003
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s \
    CMD bun -e "fetch('http://127.0.0.1:3003/').then(r => process.exit(r.ok ? 0 : 1), () => process.exit(1))"
ENTRYPOINT ["/repo/apps/mcp/content-entrypoint.sh"]
