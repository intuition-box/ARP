# Read by BuildKit for apps/web/Dockerfile, with the repository root as the context.
# An allowlist: nothing enters the image unless it is named here, so no `.env`, `.dev.vars`,
# `.wrangler` or other local file can, whatever sits untracked in a local checkout.
*

# The workspace's manifests: `bun install --frozen-lockfile` resolves every workspace from the lockfile.
!package.json
!bun.lock
!apps/*/package.json
!contracts/package.json

# What the site builds from.
!apps/web
!packages/protocol
!packages/graphql
!data/catalogue
!data/deployments

# Dropped again inside what was allowed.
**/node_modules
**/dist
**/*.test.ts
**/*.test.tsx
**/.env
**/.env.*
**/.dev.vars*
**/.wrangler
**/.agents
