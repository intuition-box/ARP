{
    "name": "@arp-protocol/core",
    "version": "0.0.1",
    "description": "ERC-8004 trust connector. Holds no key and sends no transaction; signs only through a signer the caller injects. Resolves an agent identity to one merged profile — every trust provider's assessment with its EIP-712 signature verified and its declared freshness enforced, plus capabilities and live market data. Prepares, but never sends, the calls an agent uses to declare what it used and stake on it.",
    "type": "module",
    "exports": {
        ".": {
            "arp-source": "./src/index.ts",
            "bun": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./node": {
            "arp-source": "./src/node/index.ts",
            "bun": "./src/node/index.ts",
            "types": "./dist/node/index.d.ts",
            "default": "./dist/node/index.js"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "src",
        "README.md"
    ],
    "scripts": {
        "test": "bun run --cwd ../graphql build && vitest run --coverage",
        "test:watch": "bun run --cwd ../graphql build && vitest",
        "build": "bun run --cwd ../graphql build && tsc -p tsconfig.build.json",
        "lint": "bun run --cwd ../graphql build && tsc --noEmit -p tsconfig.json",
        "format:check": "prettier --check .",
        "prepublishOnly": "bun run build"
    },
    "dependencies": {
        "@arp-protocol/graphql": "workspace:*",
        "viem": "2.52.0"
    },
    "devDependencies": {
        "@types/node": "^24.12.2",
        "@vitest/coverage-v8": "4.1.8",
        "typescript": "~6.0.2",
        "vitest": "^4.1.8"
    },
    "keywords": [
        "erc-8004",
        "agent-reputation",
        "intuition",
        "eip-712",
        "rfc-8785",
        "trust-layer"
    ],
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "sideEffects": false
}
